#!/usr/bin/env python3
"""Unprivileged client: lamp on | off | bright 50 | temp 50 | white 80 | color purple"""
import os
import socket
import sys

SOCK = os.environ.get("LAMPD_SOCK", "/run/lampd/lampd.sock")

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print(__doc__)
    sys.exit(0)
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(10)
        conn.connect(SOCK)
        conn.sendall(" ".join(sys.argv[1:]).encode())
        reply = conn.recv(512).decode("utf-8", "replace").strip()
except OSError as error:
    sys.exit(f"cannot reach lampd ({error}). Is it running? systemctl status lampd")
print(reply)
sys.exit(0 if reply.startswith("ok") else 1)
