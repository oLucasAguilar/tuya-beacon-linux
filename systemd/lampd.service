[Unit]
Description=Tuya Beacon lamp daemon (Bluetooth advertising)
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=@USER@
Group=@USER@
# Raw HCI advertising needs CAP_NET_RAW only (tested: CAP_NET_ADMIN is not needed).
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
RuntimeDirectory=lampd
RuntimeDirectoryMode=0750
# The code runs from a root-owned copy, and -I keeps Python from loading anything
# the user could write (user site-packages, .pth files, PYTHON* variables).
ExecStart=/usr/bin/python3 -I @ROOT@/bin/lampd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
