[Unit]
Description=Tuya Beacon lamp daemon (Bluetooth advertising)
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=@USER@
Group=@USER@
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
RuntimeDirectory=lampd
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 @ROOT@/bin/lampd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
